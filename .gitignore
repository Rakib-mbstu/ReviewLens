# LLM response cache and run outputs (reproducible from scripts; may contain raw responses)
cache/
runs/

# Raw mined corpus — commit the mining script + pinned PR list instead
data/corpus/*
!data/corpus/manifest.json
!data/corpus/categories.json
data/corpus-subset30/*
!data/corpus-subset30/manifest.json
!data/corpus-subset30/categories.json

# Local planning notes (tickets live as GitHub issues)
BACKLOG.md

# Secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Subagent relay scratch: batches/ are mechanical splits of the committed
# *.requests.jsonl, backups/ are pre-regeneration copies of committed CSVs.
# Neither is a record of what a model was actually sent or answered.
work/*/batches/
work/halluc/backups/
